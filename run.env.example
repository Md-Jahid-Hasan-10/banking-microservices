# Copy this file to run.env and fill in the values.
# NEVER commit run.env (it is in .gitignore). Only this example file is committed.
#
# Values with special characters ($ # spaces quotes) must be in single quotes:
#   MAIL_PASSWORD='abcd efgh ijkl mnop'

# ---------------- PostgreSQL ----------------
DB_USER=banking_admin
DB_PASSWORD=change-me
DB_PORT=5433

# ---------------- Gmail (notification-service) ----------------
# MAIL_PASSWORD is a Gmail "app password", not your normal password.
MAIL_USERNAME=your-address@gmail.com
MAIL_PASSWORD='your-gmail-app-password'

# ---------------- OTP ----------------
# true  = the OTP service writes every code into its log. Needed only for
#         node banking-web-ui/smoke-test.js. NEVER use true with real data.
# false = normal behavior.
OTP_LOG_DEV=false

# ---------------- Redis ----------------
REDIS_PASSWORD=change-me

# ---------------- Event encryption ----------------
# Shared AES key of user-service, otp-service and notification-service.
# It MUST be the same value in all three.
# Create one:  openssl rand -base64 32
EVENT_CRYPTO_KEY=

# ---------------- Grafana ----------------
GRAFANA_ADMIN_PASSWORD=change-me

# ---------------- Login token ----------------
# The secret that signs the login token (user-service) and the secret that
# verifies it (api-gateway). They MUST be the same string. If they differ,
# the login succeeds but every authenticated call answers 401 "Invalid or
# expired token" and the web UI bounces straight back to the login page.
#
# run-all.sh exports this to every service, so it wins over any .env file
# that a service happens to load from its working directory.
# Create one:  openssl rand -base64 48
JWT_SECRET='replace-with-a-long-random-string'

# ---------------- Transfers ----------------
# Send the OTP to the address of the user who started the transaction.
# Any other value sends every OTP to that one address instead.
TRANSFER_NOTIFY_EMAIL=USER

# The saga flow is the one the web UI understands: it returns 202 with
# status VALIDATING, and the UI polls until the OTP is requested.
# With it turned off the UI refuses the response and never shows the OTP box.
TRANSFER_SAGA_ENABLED=true
